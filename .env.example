# Pulseboard – Beispielkonfiguration. Kopieren nach .env und anpassen:
#   cp .env.example .env && node --env-file=.env src/server.js
# Keine echten Secrets in dieser Datei committen (.env ist in .gitignore).

# --- Server ------------------------------------------------------------------
PORT=3000
# SQLite-Datei (Verzeichnis wird angelegt)
DB_FILE=data/pulseboard.db
# "production" aktiviert Secure-Cookies (HTTPS nötig) und erzwingt APP_URL
NODE_ENV=development
# Öffentliche Basis-URL ohne Slash am Ende – für Links in E-Mails und Stripe-Redirects
APP_URL=http://localhost:3000
# HMAC-Schlüssel für Abmelde-Links in E-Mails. Leer = wird generiert und in der DB gespeichert.
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# --- Stripe (leer lassen = Billing deaktiviert, alles läuft im Free-Plan) ------
# API-Schlüssel aus dem Stripe-Dashboard (Test: sk_test_…, Live: sk_live_…)
STRIPE_SECRET_KEY=
# Signatur-Secret des Webhook-Endpunkts /api/stripe/webhook (whsec_…)
# Lokal: `stripe listen --forward-to localhost:3000/api/stripe/webhook` gibt es aus
STRIPE_WEBHOOK_SECRET=
# Preis-IDs der monatlichen Abos (price_…)
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- E-Mail ------------------------------------------------------------------
# log = nur Konsolenausgabe (Entwicklung), resend = Versand über Resend
# Standard: resend, wenn RESEND_API_KEY gesetzt ist, sonst log
MAIL_TRANSPORT=log
# API-Schlüssel von https://resend.com (re_…)
RESEND_API_KEY=
# Absender – die Domain muss bei Resend verifiziert sein (SPF/DKIM)
MAIL_FROM=Pulseboard <noreply@example.com>
